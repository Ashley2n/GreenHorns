
# .gitignore

```gitignore
# Flask and Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
ENV/

# Environment variables
.env
.venv

# Database
*.db
*.sqlite3
instance/

# Logs
*.log
logs/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing
.coverage
htmlcov/
.pytest_cache/

# Production
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Static files (if you want to ignore generated files)
static/uploads/*
!static/uploads/.gitkeep

# Flask specific
.flaskenv

# Deployment
.vercel
.netlify

# Temporary files
tmp/
temp/

# Documentation
docs/_build/

# SSL certificates
*.key
*.pem
*.crt

# macOS
*.DS_Store?

# Windows
[Dd]esktop.ini

# Linux
*~

# Backup files
*.bak
*.backup

# Session files
*.session

# Coverage reports
.coverage
.coverage.*